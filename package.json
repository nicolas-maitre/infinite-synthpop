{
  "name": "infinite-synthpop",
  "private": true,
  "version": "0.1.0",
  "description": "Endless generative 80s synth-pop in the style of True Faith / The Different Story",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "fetch-samples": "node scripts/fetch-samples.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@11.0.8"
}
